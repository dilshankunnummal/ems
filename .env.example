# ==============================================================================
# Enterprise Employee Management System — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ==============================================================================

# --- App ---
APP_NAME="Enterprise Employee Management System"
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Security / JWT ---
SECRET_KEY=change-this-to-a-64-char-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- Database (PostgreSQL) ---
# DATABASE_URL / DATABASE_URL_SYNC are DERIVED from these five values at
# runtime (see app/core/config/settings.py) — do not set them separately,
# there is nowhere to set them; changing DB_PASSWORD here is enough.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ems_user
DB_PASSWORD=change-this-password
DB_NAME=ems_db
DB_ECHO=false

# --- Redis ---
# REDIS_URL is likewise derived from these values.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# --- Rate Limiting ---
RATE_LIMIT_TIMES=100
RATE_LIMIT_SECONDS=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@ems.com
SMTP_FROM_NAME="EMS Notifications"
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:3000

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
ALLOWED_DOCUMENT_EXTENSIONS=.pdf,.doc,.docx

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Superuser (seed) ---
FIRST_SUPERUSER_EMAIL=admin@ems.com
FIRST_SUPERUSER_PASSWORD=ChangeMe123!
FIRST_SUPERUSER_FULL_NAME="System Administrator"
